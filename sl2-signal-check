#!/usr/bin/env python3
"""Measure the quality of the timecode a Rane SL2 delivers and say what to fix.

Records a few seconds of the SL2's inputs and reports level, clipping,
reference tone frequency and phase between channels. Each measurement
points to a concrete physical cause: low level is usually a misplaced
PHONO/LINE switch, clipping kills the position data even when the circle
looks fine, and a shifted frequency gives away a clock problem.

No dependencies beyond the stdlib and alsa-utils.
"""
import argparse
import math
import os
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import wave

RATE = 44100
CHANNELS = 4
SERATO_TONE = 1000.0        # Serato CV02 reference tone
FULL = 2 ** 31

BOLD, RED, YEL, GRN, OFF = "\033[1m", "\033[31m", "\033[33m", "\033[32m", "\033[0m"
if not sys.stdout.isatty():
    BOLD = RED = YEL = GRN = OFF = ""


def die(msg):
    sys.stdout.flush()
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def find_card():
    """Return the SL2's ALSA card index."""
    try:
        text = open("/proc/asound/cards", encoding="utf-8").read()
    except OSError:
        die("could not read /proc/asound/cards")
    for line in text.splitlines():
        m = re.match(r"\s*(\d+)\s+\[", line)
        if m and re.search(r"rane|SL ?2", line, re.I):
            return int(m.group(1))
    die("Rane SL2 not found among the sound cards.\n"
        "  Connect it BEFORE turning on the machine (see README) and check with: cat /proc/asound/cards")


def busy(card):
    base = f"/proc/asound/card{card}"
    for sub in ("pcm0c", "pcm0p"):
        p = f"{base}/{sub}/sub0/status"
        try:
            if open(p, encoding="utf-8").readline().strip() != "closed":
                return True
        except OSError:
            pass
    return False


def capture(card, seconds):
    """Record the 4 inputs. Playback must run in parallel: the SL2's ADC
    only delivers data while the output stream is active."""
    dev = f"hw:{card},0"
    tmp = tempfile.mkdtemp(prefix="sl2check-")
    wav, sil = os.path.join(tmp, "in.wav"), os.path.join(tmp, "sil.raw")
    with open(sil, "wb") as f:
        f.write(b"\0" * (RATE * (seconds + 2) * CHANNELS * 4))
    play = subprocess.Popen(
        ["aplay", "-D", dev, "-f", "S32_LE", "-c", str(CHANNELS), "-r", str(RATE), sil],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        rec = subprocess.run(
            ["arecord", "-D", dev, "-f", "S32_LE", "-c", str(CHANNELS),
             "-r", str(RATE), "-d", str(seconds), wav],
            capture_output=True, text=True)
    finally:
        play.terminate()
        play.wait(timeout=5)
    if rec.returncode != 0:
        msg = rec.stderr.strip().splitlines()
        detail = msg[0] if msg else "no details"
        die(f"arecord failed: {detail}\n"
            "  If it says 'Unable to install hw params', the module with the quirk is not active.")
    with wave.open(wav) as w:
        n = w.getnframes()
        raw = w.readframes(n)
    shutil.rmtree(tmp, ignore_errors=True)
    flat = struct.unpack(f"<{n * CHANNELS}i", raw)
    return [list(flat[c::CHANNELS]) for c in range(CHANNELS)]


def goertzel(xs, freq, sr):
    """Complex amplitude at one frequency. Cheaper than a full FFT."""
    w = 2 * math.pi * freq / sr
    cw, sw, coeff = math.cos(w), math.sin(w), 2 * math.cos(w)
    s1 = s2 = 0.0
    for x in xs:
        s1, s2 = x + coeff * s1 - s2, s1
    return complex(s1 - s2 * cw, s2 * sw) * (2.0 / len(xs))


def dominant(xs, sr, lo=700.0, hi=1400.0):
    """Coarse then fine sweep, to also catch a shifted tone."""
    seg = xs[:8192]
    best_f, best_m = lo, -1.0
    f = lo
    while f <= hi:
        m = abs(goertzel(seg, f, sr))
        if m > best_m:
            best_m, best_f = m, f
        f += 5.0
    f = best_f - 5.0
    while f <= best_f + 5.0:
        m = abs(goertzel(seg, f, sr))
        if m > best_m:
            best_m, best_f = m, f
        f += 0.5
    return best_f, best_m


def db(x):
    return 20 * math.log10(x) if x > 1e-12 else float("-inf")


def fmt(x):
    return "  -inf" if x == float("-inf") else f"{x:6.1f}"


def main():
    ap = argparse.ArgumentParser(description="Rane SL2 timecode diagnostics")
    ap.add_argument("-d", "--seconds", type=int, default=3, help="seconds to record (default 3)")
    ap.add_argument("-c", "--card", type=int, help="ALSA card index (default: autodetect)")
    args = ap.parse_args()

    for t in ("arecord", "aplay"):
        if not shutil.which(t):
            die(f"'{t}' is missing. Install alsa-utils.")

    card = args.card if args.card is not None else find_card()
    print(f"{BOLD}Rane SL2 on card {card}{OFF}")
    if busy(card):
        die("the device is in use. Close Mixxx (or any other audio program) and try again.")

    print(f"Recording {args.seconds} s. Keep the needle down and the record spinning...\n")
    ch = capture(card, args.seconds)

    problems, notes = [], []

    print(f"{BOLD}Levels{OFF}")
    stats = []
    for i, xs in enumerate(ch):
        pk = max(abs(v) for v in xs) / FULL
        rms = math.sqrt(sum(float(v) * v for v in xs) / len(xs)) / FULL
        clipped = sum(1 for v in xs if abs(v) > 0.995 * FULL)
        stats.append((pk, rms, clipped))
        tag = f"{RED}  CLIPPING ({clipped} samples){OFF}" if clipped else ""
        print(f"  CH{i+1}: peak {fmt(db(pk))} dBFS   rms {fmt(db(rms))} dBFS{tag}")

    pk1, rms1, clip1 = stats[0]
    pk2, rms2, clip2 = stats[1]

    if clip1 or clip2:
        problems.append(
            "The signal is CLIPPING. The reference tone survives and the circle looks fine,\n"
            "     but the position data is destroyed and the track doesn't move.\n"
            "     Lower Mixxx's turntable input signal boost to 0 dB, and check that the\n"
            "     turntable isn't on LINE with the Rane on PHONO (two preamps stacked).")
    elif db(pk1) < -45:
        problems.append(
            "Level too low. Typically the turntable is on LINE with the Rane on\n"
            "     PHONO, or the other way around, or the needle is lifted. Set both switches to PHONO.")

    if db(max(stats[2][1], stats[3][1])) > -40:
        notes.append("Channels 3-4 carry signal: a second turntable is connected.")

    print(f"\n{BOLD}Reference tone{OFF}  (Serato CV02 = 1000 Hz)")
    f1, m1 = dominant(ch[0], RATE)
    f2, m2 = dominant(ch[1], RATE)
    print(f"  CH1: {f1:7.1f} Hz     CH2: {f2:7.1f} Hz")

    if m1 / FULL < 1e-5:
        problems.append(
            "No timecode tone. Needle lifted, platter stopped, or the record isn't\n"
            "     Serato timecode.")
    else:
        off = (f1 / SERATO_TONE - 1) * 100
        if abs(off) > 3:
            problems.append(
                f"The tone is {off:+.1f}% off from 1000 Hz.\n"
                f"     A deviation close to +8.8% means the driver declares 48000 Hz\n"
                f"     while the hardware runs at 44100: the module with the quirk is not\n"
                f"     active. Check 'dkms status' and reload snd_usb_audio.")
        else:
            notes.append(f"Frequency correct, deviation {off:+.2f}% (your turntable's accuracy).")

    print(f"\n{BOLD}Quadrature{OFF}  (both channels must be 90 degrees apart)")
    g1, g2 = goertzel(ch[0][:8192], f1, RATE), goertzel(ch[1][:8192], f1, RATE)
    if abs(g1) / FULL < 1e-5 or abs(g2) / FULL < 1e-5:
        print("  not measurable: a channel has no signal")
        problems.append("One of the two channels has no signal. Check that turntable's RCA cable.")
    else:
        d = math.degrees(math.atan2((g2 / g1).imag, (g2 / g1).real))
        ok = 60 < abs(d) < 120
        col = GRN if ok else RED
        print(f"  phase CH1-CH2: {col}{d:+.1f} degrees{OFF}   "
              f"{'correct' if ok else 'OUT OF QUADRATURE'}")
        if not ok:
            problems.append(
                "No quadrature. Both channels carry nearly the same thing: probably a\n"
                "     loose or misplaced RCA, or a mono input.")

    print()
    if problems:
        print(f"{BOLD}{RED}Needs fixing{OFF}")
        for p in problems:
            print(f"  {RED}*{OFF} {p}")
    else:
        print(f"{BOLD}{GRN}Healthy signal.{OFF} Level, frequency and quadrature are correct.")
    for n in notes:
        print(f"  {YEL}-{OFF} {n}")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
